  "directives": [
    {
      "address": "31968L0151",
      "date": "1968-09-03",
      "title": "PIERWSZA DYREKTYWA RADY z dnia 9 marca 1968 r. w sprawie koordynacji gwarancji, jakie są wymagane w Państwach Członkowskich od spółek w rozumieniu art. 58 akapit drugi Traktatu, w celu uzyskania ich równoważności w całej Wspólnocie, dla zapewnienia ochrony interesów zarówno wspólników jak i osób trzecich"
    },
    {
      "address": "31977L0091",
      "date": "1976-12-13",
      "title": "DRUGA DYREKTYWA RADY z dnia 13 grudnia 1976 r. w sprawie koordynacji gwarancji, jakie są wymagane w Państwach Członkowskich od spółek w rozumieniu art. 58 akapit drugi Traktatu, w celu uzyskania ich równoważności, dla ochrony interesów zarówno wspólników, jak i osób trzecich w zakresie tworzenia spółki akcyjnej, jak również utrzymania i zmian jej kapitału"
    },
    {
      "address": "31978L0855",
      "date": "1978-09-10",
      "title": "Trzecia dyrektywa Rady 78/855/EWG z dnia 9 października 1978 r. wydana na podstawie art. 54 ust. 3 lit. g) Traktatu, dotycząca łączenia się spółek akcyjnych"
    },
    {
      "address": "31982L0891",
      "date": "1982-12-17",
      "title": "Szósta dyrektywa Rady 82/891/EWG z dnia 17 grudnia 1982 r. wydana na podstawie art. 54 ust. 3 lit. g) Traktatu dotycząca podziału spółek akcyjnych"
    },
    {
      "address": "31989L0666",
      "date": "1989-12-21",
      "title": "Jedenasta Dyrektywa Rady z dnia 21 grudnia 1989 r. dotycząca wymogów ujawniania informacji odnośnie do oddziałów utworzonych w Państwie Członkowskim przez niektóre rodzaje spółek podlegające prawu innego państwa"
    },
    {
      "address": "31989L0667",
      "date": "1989-12-21",
      "title": "Dwunasta dyrektywa Rady w Sprawie Prawa Spółek z dnia 21 grudnia 1989 r. dotycząca jednoosobowych spółek z ograniczoną odpowiedzialnością"
    },
    {
      "address": "32001L0017",
